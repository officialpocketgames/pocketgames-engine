Subject: [PATCH] Report geometry shaders and transform feedback only with mesh shaders

Spec 34 clarification 1, item 4. The geometry-shaders branch emulates geometry shaders and
transform feedback with Metal mesh shaders, and reports geometryShader, transformFeedback and
geometryStreams as true on every GPU. Metal runs mesh shaders on Apple7 (A14) and Mac2 GPUs
with Metal 3 (iOS 16, macOS 13), so on an A12 or A13 a program would be told it may create
pipelines that cannot be built. Report the three features, and VK_EXT_transform_feedback, only
where mvkSupportsMeshEmulation() holds. Applies after steamac's 0001-0047 (the adopted set).
The changed file keeps its licence header and says it was changed (Apache-2.0 section 4(b)).

--- a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
@@ -3,6 +3,9 @@
  *
  * Copyright (c) 2015-2025 The Brenwill Workshop Ltd. (http://www.brenwill.com)
  *
+ * Changed for MYIOSDECK (2026): geometry shaders and transform feedback are reported only on
+ * GPUs that run Metal mesh shaders.
+ *
  * Licensed under the Apache License, Version 2.0 (the "License");
  * you may not use this file except in compliance with the License.
  * You may obtain a copy of the License at
@@ -139,6 +142,12 @@
 #endif
 }
 
+// MYIOSDECK: geometry shaders and transform feedback are emulated with Metal mesh shaders, which
+// need an Apple7 (A14) or Mac2 GPU and Metal 3 (iOS 16, macOS 13). Older GPUs report neither.
+static bool mvkSupportsMeshEmulation(const MVKMTLDeviceCapabilities& caps) {
+	return (caps.supportsApple7 || caps.supportsMac2) && caps.supportsMetal3;
+}
+
 
 #pragma mark -
 #pragma mark MVKPhysicalDevice
@@ -802,8 +811,8 @@
 			}
 			case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TRANSFORM_FEEDBACK_FEATURES_EXT: {
 				auto* transformFeedbackFeatures = (VkPhysicalDeviceTransformFeedbackFeaturesEXT*)next;
-				transformFeedbackFeatures->transformFeedback = true;
-				transformFeedbackFeatures->geometryStreams = true; // FIXME: lie about this for DXVK
+				transformFeedbackFeatures->transformFeedback = mvkSupportsMeshEmulation(_gpuCapabilities);
+				transformFeedbackFeatures->geometryStreams = mvkSupportsMeshEmulation(_gpuCapabilities); // FIXME: lie about this for DXVK
 				break;
 			}
 			default:
@@ -2786,7 +2795,7 @@
     _features.robustBufferAccess = true; // NOTE: Required by spec, not fully supported by non-Apple GPUs.
     _features.fullDrawIndexUint32 = true;
     _features.independentBlend = true;
-    _features.geometryShader = true;  // XXX Required by DXVK for D3D10
+    _features.geometryShader = mvkSupportsMeshEmulation(_gpuCapabilities);  // XXX Required by DXVK for D3D10
     _features.sampleRateShading = true;
 	_features.logicOp = getMVKConfig().useMetalPrivateAPI;
     _features.depthBiasClamp = true;
@@ -3591,6 +3600,9 @@
 	if (!_metalFeatures.placementHeaps) {
 		pWritableExtns->vk_EXT_image_2d_view_of_3d.enabled = false;
 	}
+	if (!mvkSupportsMeshEmulation(_gpuCapabilities)) {
+		pWritableExtns->vk_EXT_transform_feedback.enabled = false;
+	}
 
     // gpuAddress requires Tier2 argument buffer support (per feedback from Apple engineers).
     if (_metalFeatures.argumentBuffersTier < MTLArgumentBuffersTier2) {
