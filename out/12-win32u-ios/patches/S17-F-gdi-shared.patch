 extern const struct user_driver_funcs *user_driver;
 extern struct client_surface *nulldrv_client_surface_create( HWND hwnd );
 
+#ifdef WINE_IOS
+/* MYIOSDECK (spec 17 F1): the calling thread's allocation ceiling (spec 12 B1), one function
+ * for every use of zero_bits in win32u. The macro comes after wine/server.h: the request
+ * structs of the server protocol have members of that name. syscall.c #undefs it to define the
+ * old global, which stays 0. */
+extern ULONG_PTR w32ios_zero_bits(void);
+static inline ULONG_PTR win32u_alloc_ceiling(void)
+{
+    return w32ios_zero_bits();
+}
+#define zero_bits win32u_alloc_ceiling()
+#else
 extern ULONG_PTR zero_bits;
+#endif
 
 static inline BOOL set_ntstatus( NTSTATUS status )
 {
