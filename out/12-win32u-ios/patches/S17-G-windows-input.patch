  *
  * Changed for MYIOSDECK (iOS, spec 12): see out/12-win32u-ios/CHANGES.md
+ * Changed for MYIOSDECK (iOS, spec 17 G1, G2): see out/12-win32u-ios/CHANGES.md
  *
  * Copyright 1993, 1994 Alexandre Julliard
  *
@@ -172,6 +173,11 @@
         shared_object_acquire_seqlock( object, &lock->seq );
         *window_shm = &object->shm.window;
         lock->id = object->id;
+#ifdef WINE_IOS
+        /* MYIOSDECK (spec 17 G1): id 0 is a window object freed with a dead pseudo-process; the
+         * caller's retry loop holds user_lock, so fail instead of retrying for ever */
+        if (!lock->id) return STATUS_INVALID_HANDLE;
+#endif
         return STATUS_PENDING;
     }
 
@@ -856,6 +862,23 @@
     return list;
 }
 
+#ifdef WINE_IOS
+/* MYIOSDECK (spec 17 G2): the steps of the GA_ROOT walk (w32ios_s17_root_walk); the desktop
+ * window ends it */
+static uint64_t ios_root_walk_parent( void *ctx, uint64_t hwnd )
+{
+    HWND parent = NtUserGetAncestor( (HWND)(ULONG_PTR)hwnd, GA_PARENT );
+
+    if (!parent || is_desktop_window( parent )) return 0;
+    return (ULONG_PTR)parent;
+}
+
+static int ios_root_walk_is_child( void *ctx, uint64_t hwnd )
+{
+    return (get_window_long( (HWND)(ULONG_PTR)hwnd, GWL_STYLE ) & WS_CHILD) != 0;
+}
+#endif
+
 /*****************************************************************
  *           NtUserGetAncestor (win32u.@)
  */
@@ -890,7 +913,26 @@
         break;
 
     case GA_ROOT:
+#ifdef WINE_IOS
+        /* MYIOSDECK (spec 17 G2): when the parent list can't be read, walk up with GA_PARENT
+         * while the window is WS_CHILD (a dialog's buttons otherwise have no top window, and a
+         * click on them loses its button-down) */
+        if (!(list = list_window_parents( hwnd )))
+        {
+            static LONG logged;
+
+            if (!is_window( hwnd )) return 0;
+            ret = (HWND)(ULONG_PTR)w32ios_s17_root_walk( (ULONG_PTR)hwnd, ios_root_walk_parent,
+                                                         ios_root_walk_is_child, NULL, 64 );
+            ret = get_full_window_handle( ret );
+            if (!InterlockedExchange( &logged, 1 ))
+                w32ios_log( "GetAncestor(%p, GA_ROOT): no parent list, root %p from the GA_PARENT walk",
+                            hwnd, ret );
+            return ret;
+        }
+#else
         if (!(list = list_window_parents( hwnd ))) return 0;
+#endif
 
         if (!list[0] || !list[1]) ret = get_full_window_handle( hwnd );  /* top-level window */
         else
