Spec 12 Part B audit: per-process user interface state of upstream becomes per pseudo-process:
menu tracking (menu.c), scroll bar tracking (scroll.c), the primary and last realized palettes
(palette.c), registered raw input devices (rawinput.c), the F10 / system menu key state
(defwnd.c), EnableMouseInPointer and the caret (input.c), the process-wide IME switch (imm.c).

--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -1,3 +1,5 @@
 /*
  * Menu functions
+ *
+ * Changed for MYIOSDECK (iOS, spec 12): see out/12-win32u-ios/CHANGES.md
  *
@@ -154,7 +156,13 @@
 static HWND top_popup;
 static HMENU top_popup_hmenu;
 
 /* Flag set by NtUserEndMenu() to force an exit from menu tracking */
 static BOOL exit_menu = FALSE;
+#ifdef WINE_IOS
+#include "w32ios.h"
+#define top_popup       (w32ios_proc_current()->pp_top_popup)   /* per pseudo-process */
+#define top_popup_hmenu (w32ios_proc_current()->pp_top_popup_hmenu)
+#define exit_menu       (w32ios_proc_current()->pp_exit_menu)
+#endif
 
 static SIZE menucharsize;
